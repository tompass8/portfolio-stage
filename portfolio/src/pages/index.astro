---
import Layout from "../layouts/Layout.astro";
import GateLink from "../components/sign/GateLink.astro";
import SectionSign from "../components/sign/SectionSign.astro";
import ProjectGate from "../components/sign/ProjectGate.astro";
import DepartureBoard from "../components/sign/DepartureBoard.astro";
import Directory from "../components/sign/Directory.astro";
import ContactPanel from "../components/sign/ContactPanel.astro";
import SiteFooter from "../components/sign/SiteFooter.astro";
import Picto from "../components/sign/Picto.astro";
import { projects } from "../data/projects";
import { resumeData } from "../data/resumeData";

const { meta, spawn, skills, experience } = resumeData;
// Projets du CV non détaillés plus haut (Le Gourmand et Spark ont déjà leur porte)
const others = resumeData.projects.items.filter((p) => p.id !== "le-gourmand" && p.id !== "spark");

const nav = [
  { href: "#projets", label: "Projets", picto: "down" as const },
  { href: "#parcours", label: "Parcours", picto: "briefcase" as const },
  { href: "#competences", label: "Compétences", short: "Stack", picto: "grid" as const },
  { href: "/cv", label: "CV jeu", picto: "play" as const },
  { href: "/tbrain", label: "TBRAIN", picto: "orbit" as const },
  { href: "#contact", label: "Contact", picto: "mail" as const },
];

const boardRows = [
  ...experience.jobs.map((j) => ({ when: j.period, where: j.company, what: j.role })),
  { when: "En cours", where: "Ynov Campus Toulouse", what: "Bachelor Informatique" },
];
---
<Layout title="Tom Passerman · Développement web, systèmes & réseaux, IoT" nav={nav}>
  <!-- Premier écran : qui, puis les trois portes -->
  <section aria-labelledby="identite" class="mx-auto max-w-[90rem] px-4 pb-12 pt-10 sm:px-6 sm:pt-14">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <div>
        <h1 id="identite" class="text-display font-bold tracking-[-0.03em]">Tom Passerman</h1>
        <p class="mt-4 max-w-[40rem] text-2xl leading-snug sm:text-[1.75rem]">
          Étudiant en Bachelor Informatique à Ynov Campus Toulouse. {meta.headline.replace("Passionné d'IT : ", "")}.
        </p>
      </div>
      <div class="flex flex-col items-start gap-4 lg:items-end">
        <p class="flex items-center gap-3 text-xl font-semibold">
          <Picto name="pin" size="sm" />
          {meta.location} · cherche un stage ou une alternance
        </p>
        <a href="#contact" class="press group inline-flex min-h-12 items-center gap-3 rounded-[6px] bg-ink py-2 pl-2 pr-5 text-xl font-semibold text-sign no-underline">
          <Picto name="mail" size="sm" class="bg-sign! text-ink!" />
          Écrire à Tom
        </a>
      </div>
    </div>

    <ul class="mt-10 grid gap-4 md:grid-cols-3" aria-label="Projets">
      {projects.map((p, i) => (
        <li data-rise style={`--d:${i}`}>
          <GateLink href={`#projet-${p.slug}`} num={p.id} title={p.title.replace(" (Groupe Immobilier)", "")} line={p.subtitle} />
        </li>
      ))}
    </ul>
  </section>

  <section id="projets" aria-label="Projets">
    <SectionSign title="Projets" picto="gate" aside={`${projects.length} portes`} />
    <div class="mx-auto max-w-[90rem] px-4 sm:px-6">
      {projects.map((p) => <ProjectGate project={p} />)}

      <div class="border-t-[6px] border-ink py-12 sm:py-16">
        <h3 class="text-3xl font-bold tracking-[-0.015em]">Autres projets</h3>
        <ul class="mt-6 divide-y-2 divide-rule border-y-2 border-rule">
          {others.map((o, i) => (
            <li data-rise style={`--d:${i}`} class="row-hover grid gap-x-10 gap-y-2 py-5 md:grid-cols-[minmax(0,16rem)_minmax(0,1fr)]">
              <div>
                <h4 class="text-2xl font-bold leading-tight">{o.name}</h4>
                <p class="mt-1 text-base font-semibold text-muted">{o.kind}</p>
              </div>
              <div class="max-w-[40rem]">
                <p class="text-lg leading-relaxed">{o.summary}</p>
                <p class="mt-2 text-base text-muted">{o.stack.join(" · ")}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="parcours" aria-label="Parcours">
    <SectionSign title="Parcours" picto="briefcase" aside={`${experience.jobs.length} escales`} />
    <div class="mx-auto max-w-[90rem] px-4 py-12 sm:px-6 sm:py-16">
      <p class="mb-8 max-w-[40rem] text-xl">{experience.intro}</p>
      <DepartureBoard caption="Expériences et formation" rows={boardRows} />
      <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
        {experience.jobs.map((j, i) => (
          <div data-rise style={`--d:${i}`}>
            <h3 class="text-2xl font-bold">{j.company} <span class="font-normal text-muted">· {j.period}</span></h3>
            <p class="mt-1 text-lg font-semibold">{j.role}</p>
            <ul class="mt-4 space-y-2 text-lg">
              {j.missions.map((m) => (
                <li class="flex gap-3"><span aria-hidden="true" class="mt-[0.6em] size-2 shrink-0 bg-ink"></span>{m}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-[40rem] text-xl leading-relaxed">{spawn.bio}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {spawn.highlights.map((h) => (
          <li class="rounded-[4px] border-2 border-ink px-3 py-1 text-base font-semibold">{h}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="competences" aria-label="Compétences">
    <SectionSign title="Compétences" picto="grid" aside={`${skills.groups.length} familles`} />
    <div class="mx-auto max-w-[90rem] px-4 py-12 sm:px-6 sm:py-16">
      <p class="mb-8 max-w-[40rem] text-xl">{skills.intro}</p>
      <Directory groups={skills.groups} />
    </div>
  </section>

  <section aria-label="CV interactif" class="bg-ink">
    <a href="/cv" class="group on-dark mx-auto flex max-w-[90rem] flex-wrap items-center gap-5 px-4 py-10 text-sign no-underline sm:px-6">
      <Picto name="play" size="lg" class="bg-sign! text-ink!" />
      <span class="text-3xl font-bold leading-tight tracking-[-0.015em] sm:text-4xl">Parcourir mon CV en jeu 2D</span>
      <span class="text-xl text-on-board">Le même parcours, en monde à défilement horizontal</span>
      <Picto name="up-right" class="ml-auto bg-sign! text-ink! transition-transform duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
    </a>
  </section>

  <section id="contact" aria-label="Contact">
    <SectionSign title="Contact" picto="mail" aside="Disponible immédiatement" />
    <div class="mx-auto max-w-[90rem] px-4 py-12 sm:px-6 sm:py-16">
      <ContactPanel />
    </div>
  </section>

  <SiteFooter slot="footer" />
</Layout>
