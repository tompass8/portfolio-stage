---
import Layout from "../layouts/Layout.astro";
import GateLink from "../components/sign/GateLink.astro";
import SectionSign from "../components/sign/SectionSign.astro";
import Route from "../components/sign/Route.astro";
import CommitLog from "../components/sign/CommitLog.astro";
import ContactPanel from "../components/sign/ContactPanel.astro";
import SiteFooter from "../components/sign/SiteFooter.astro";
import Picto from "../components/sign/Picto.astro";
import NetworkMap from "../components/governance/NetworkMap.astro";
import GdprLock from "../components/governance/GdprLock.astro";
import RolesMatrix from "../components/governance/RolesMatrix.astro";
import { projects } from "../data/projects";

const nav = [
  { href: "#web", label: "Web 75 %", short: "Web", picto: "code" as const },
  { href: "#methode", label: "Méthode", picto: "right" as const },
  { href: "#gouvernance", label: "Gouvernance 25 %", short: "Gouvernance", picto: "shield" as const },
  { href: "#contact", label: "Contact", picto: "mail" as const },
];

const reasons = [
  {
    title: "Mon parcours terrain",
    body: "Étudiant en informatique à <strong>Ynov Toulouse</strong>, j'ai déjà fait tourner des systèmes réels : chez <strong>Orange</strong>, l'automatisation des déploiements logiciels ; chez <strong>ITL</strong>, des infrastructures réseau critiques et de la vidéosurveillance IP. En parallèle, je conçois des <strong>applications web &amp; mobiles</strong>, du prototype au déploiement.",
  },
  {
    title: "Pourquoi Alpha to Omega ?",
    body: "Au-delà de composants isolés, je vise le cycle complet : <strong>recueil du besoin</strong>, architecture Astro, CI/CD, DNS/Cloudflare, diagnostic de logs, et la <strong>gouvernance IT</strong> des organisations que vous accompagnez.",
  },
  {
    title: "L'IA comme outil critique",
    body: "Ce site a été co-construit avec l'IA, jamais livré sans relecture : architecture cadrée à la main, code <strong>vérifié ligne par ligne</strong>, erreurs Git/Vite/Tailwind corrigées manuellement, <strong>performance et accessibilité</strong> traitées comme des exigences.",
  },
];

// Proposition (non réalisée) : ce que l'agent ferait à chaque étape du pipeline
const agentSteps = [
  { title: "Analyser les échecs", desc: "À chaque commit ou PR, lire les erreurs de build et de tests et proposer un correctif ciblé, prêt à relire." },
  { title: "Écrire les tests manquants", desc: "Générer des tests unitaires et d'intégration pour le nouveau code, cas nominaux et cas limites compris." },
  { title: "Relire les PR", desc: "Signaler failles, vulnérabilités OWASP et problèmes de performance avant validation." },
  { title: "Réparer le pipeline", desc: "Repérer une erreur de configuration ou de dépendance (Dockerfile, YAML de workflow) et proposer le patch." },
  { title: "Tenir la doc à jour", desc: "Mettre à jour CHANGELOG, documentation d'API et README à chaque fusion." },
];

const flow = [
  "Webhook · GitHub / GitLab API",
  "Agent · Node.js / Python",
  "API LLM · Function Calling",
  "Dépôt · Patch des fichiers projet",
];

const steps = [
  { title: "Cadrage", sub: "vos besoins", points: ["Ateliers de recueil du besoin & user-stories", "Choix de la stack et des livrables", "Jalons, budget et critères d'acceptation"] },
  { title: "Développement", sub: "itératif & testé", points: ["Développement par sprints avec démos régulières", "Revue de code et tests automatisés", "Intégration continue dès le premier commit"] },
  { title: "Mise en production", sub: "sans interruption", points: ["Pipeline CI/CD reproductible", "Conteneurisation & mise en ligne sans interruption de service", "Logs, métriques et alertes en place"] },
  { title: "Suivi", sub: "après la mise en ligne", points: ["Monitoring, correctifs et évolutions", "Optimisation des performances", "Transfert de compétences & documentation"] },
];

const synthesis = [
  ["Candidat", "Tom Passerman"],
  ["Formation", "Bachelor Info, Ynov Toulouse"],
  ["Stages précédents", "Orange & ITL"],
  ["Anglais technique", "Courant, oral & écrit"],
];
---
<Layout
  title="Tom Passerman · Candidature Alpha to Omega | Web, IA & Gouvernance Numérique"
  description="Candidature de Tom Passerman chez Alpha to Omega (Développement Web, IA & Gouvernance Numérique)"
  nav={nav}
  noindex
>
  <section aria-labelledby="candidature" class="mx-auto max-w-[90rem] px-4 pb-12 pt-10 sm:px-6 sm:pt-14">
    <div class="grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end">
      <div>
        <h1 id="candidature" class="text-display font-bold tracking-[-0.03em]">Candidature Alpha to Omega</h1>
        <p class="mt-4 text-2xl leading-snug">
          Développement web, IA &amp; gouvernance numérique · Tom Passerman, étudiant Bachelor Informatique (Ynov Toulouse)
        </p>
      </div>
      <p class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 self-end justify-self-start rounded-[6px] bg-ink px-4 py-2 text-lg font-semibold text-sign lg:justify-self-end">
        Toulouse · Stage de 2 à 6 mois · Disponible immédiatement
      </p>
    </div>
    <p class="mt-6 max-w-[40rem] text-xl leading-relaxed">
      Ce site interactif est ma candidature pour rejoindre <strong>Alpha to Omega</strong>. Il illustre ma compréhension de vos deux piliers : <strong>75% d'ingénierie web sur mesure</strong> (du cadrage besoin au déploiement Cloudflare avec Astro, Git et APIs) et <strong>25% de gouvernance numérique</strong> (cartographie SI, gestion des accès IAM, conformité RGPD et processus d'exploitation).
    </p>

    <ul class="mt-10 grid gap-4 md:grid-cols-3" aria-label="Accès rapide">
      <li><GateLink href="#web" num="75 %" title="Ingénierie web" line="Sur mesure, APIs & CI/CD" /></li>
      <li><GateLink href="#gouvernance" num="25 %" title="Gouvernance" line="Cartographie SI, IAM, RGPD" /></li>
      <li><GateLink href="#contact" num="2–6" title="Mois de stage" line="Disponible immédiatement : parcours et contact" /></li>
    </ul>

    <div class="mt-14 grid gap-x-10 gap-y-8 border-t-[6px] border-ink pt-10 md:grid-cols-3">
      {reasons.map((r) => (
        <article>
          <h2 class="text-2xl font-bold leading-tight">{r.title}</h2>
          <p class="mt-3 text-lg leading-relaxed" set:html={r.body} />
        </article>
      ))}
    </div>
  </section>

  <section id="web" aria-label="Ingénierie web">
    <SectionSign title="Ingénierie web" picto="code" aside="75 %" />
    <div class="mx-auto max-w-[90rem] px-4 py-12 sm:px-6 sm:py-16">
      <p class="max-w-[40rem] text-xl leading-relaxed">
        Du microcontrôleur embarqué aux conteneurs Docker en passant par des APIs .NET découplées :
        chaque brique est versionnée, testée et déployée via un pipeline reproductible.
      </p>
      <div class="mt-8"><CommitLog repoUrl="https://github.com/tompass8/portfolio-stage" /></div>

      <h3 class="mt-16 text-3xl font-bold tracking-[-0.015em]">Proposition : un agent IA dans le pipeline</h3>
      <p class="mt-3 max-w-[40rem] text-xl leading-relaxed">
        Module que je propose pour accompagner vos équipes dans l'usage concret de l'IA : un agent branché sur le pipeline
        existant. Il propose, l'humain décide : chaque action reste soumise à validation.
      </p>
      <ol class="mt-8 max-w-[52rem] divide-y-2 divide-rule border-y-2 border-rule">
        {agentSteps.map((s) => (
          <li class="grid gap-x-8 gap-y-1 py-4 md:grid-cols-[minmax(0,16rem)_minmax(0,1fr)]">
            <h4 class="text-xl font-bold">{s.title}</h4>
            <p class="text-lg leading-relaxed">{s.desc}</p>
          </li>
        ))}
      </ol>

      <div class="mt-10 rounded-[6px] bg-panel p-5 sm:p-8">
        <h4 class="text-lg font-bold">Architecture : agent LLM + Function Calling</h4>
        <div class="mt-5"><Route stops={flow} label="Flux de l'agent CI/CD" /></div>
        <p class="mt-5 border-t-2 border-concrete pt-3 text-lg text-muted">
          Chaque push/PR déclenche l'agent via webhook → diagnostic → patchs proposés en Pull Request → revue humaine → merge.
        </p>
      </div>

      <h3 class="mt-16 text-3xl font-bold tracking-[-0.015em]">Projets réalisés</h3>
      <ul class="mt-6 divide-y-2 divide-rule border-y-2 border-rule">
        {projects.map((p) => (
          <li>
            <a href={`/#projet-${p.slug}`} class="press group flex min-h-16 items-center gap-4 py-3 no-underline">
              <span class="min-w-0 flex-1">
                <span class="block text-2xl font-bold leading-tight group-hover:underline">{p.title}</span>
                <span class="block text-lg text-muted">{p.subtitle}</span>
              </span>
              <Picto name="up-right" size="sm" class="transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="methode" aria-label="Méthode de travail">
    <SectionSign title="Méthode" picto="right" aside="4 étapes" />
    <div class="mx-auto max-w-[90rem] px-4 py-12 sm:px-6 sm:py-16">
      <p class="max-w-[40rem] text-xl leading-relaxed">
        De l'idée à la production : une méthode de livraison continue, transparente et mesurable, le même niveau d'exigence
        que j'applique déjà sur mes projets et mes missions d'accompagnement, et que je mettrai
        en pratique chez Alpha to Omega.
      </p>
      <ol class="mt-10 grid gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="relative border-t-[6px] border-ink pt-6">
            <span aria-hidden="true" class="absolute -top-[1.1rem] left-0 size-7 rounded-full border-[6px] border-ink bg-sign"></span>
            <h3 class="text-3xl font-bold tracking-[-0.02em]"><span class="tabular-nums">{i + 1}.</span> {s.title}</h3>
            <p class="text-lg text-muted">{s.sub}</p>
            <ul class="mt-4 space-y-2 text-lg">
              {s.points.map((p) => (
                <li class="flex gap-3"><span aria-hidden="true" class="mt-[0.6em] size-2 shrink-0 bg-ink"></span>{p}</li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="gouvernance" aria-label="Gouvernance numérique">
    <SectionSign title="Gouvernance" picto="shield" aside="25 %" tone="ink" />
    <div class="mx-auto max-w-[90rem] px-4 py-12 sm:px-6 sm:py-16">
      <p class="max-w-[40rem] text-xl leading-relaxed">
        Recensement des actifs, cartographie des flux, contrôle des habilitations (IAM), conformité RGPD et formalisation des
        procédures d'exploitation : les missions d'accompagnement que vous menez chez Alpha to Omega sont le terrain que je vise.
        Voici comment je m'y intégrerais.
      </p>
      <div class="mt-10"><NetworkMap /></div>
      <div class="mt-4 grid gap-4 lg:grid-cols-3">
        <GdprLock />
        <div class="lg:col-span-2"><RolesMatrix /></div>
      </div>
    </div>
  </section>

  <section id="contact" aria-label="Contact">
    <SectionSign title="Contact" picto="mail" aside="Toulouse" />
    <div class="mx-auto max-w-[90rem] px-4 py-12 sm:px-6 sm:py-16">
      <div class="grid gap-x-10 gap-y-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <div>
          <h3 class="text-3xl font-bold tracking-[-0.015em]">Prêt à démarrer chez Alpha to Omega</h3>
          <p class="mt-2 text-lg leading-relaxed">
            Basé à Toulouse, disponible immédiatement pour un stage de 2 à 6 mois (35h/semaine, 9h30-18h30), avec perspective d'alternance.
          </p>
          <dl class="mt-6 divide-y-2 divide-rule border-y-2 border-rule text-lg">
            {synthesis.map(([k, v]) => (
              <div class="flex flex-wrap justify-between gap-x-4 py-2.5">
                <dt class="text-muted">{k}</dt>
                <dd class="font-semibold">{v}</dd>
              </div>
            ))}
          </dl>
        </div>
        <ContactPanel subject="Candidature de stage chez Alpha to Omega" />
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" note="Candidature Stage Alpha to Omega (A2Ω), Toulouse" />
</Layout>
