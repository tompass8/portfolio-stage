---
import GameLayout from "../layouts/GameLayout.astro";
import HudNavigation from "../components/game/HudNavigation.astro";
import InteractiveWorld from "../components/game/InteractiveWorld.astro";
import ArcadeIntro from "../components/game/ArcadeIntro.astro";
import { resumeData } from "../data/resumeData";

const { spawn, skills, experience, projects, contact } = resumeData;
---
<GameLayout title="CV interactif · Tom Passerman">
  <HudNavigation />
  <ArcadeIntro />
  <main class="relative">
    <h1 class="sr-only">CV interactif de Tom Passerman, développeur web, IA et gouvernance numérique</h1>
    <InteractiveWorld />
  </main>

  <noscript>
    <section class="mx-auto max-w-4xl bg-concrete px-6 py-16 text-ink">
      <p class="text-3xl font-bold">CV de Tom Passerman</p>
      <p class="mt-3 text-lg">{spawn.bio}</p>
      <ul class="mt-4 space-y-1 text-lg">
        {spawn.highlights.map((h) => <li>{h}</li>)}
      </ul>

      <h2 class="mt-10 text-2xl font-bold">Compétences</h2>
      {skills.groups.map((g) => (
        <div class="mt-4">
          <h3 class="text-lg font-bold">{g.title} ({g.level})</h3>
          <p class="mt-1 text-lg">{g.items.map((i) => i.name).join(" · ")}</p>
        </div>
      ))}

      <h2 class="mt-10 text-2xl font-bold">Expériences</h2>
      {experience.jobs.map((j) => (
        <div class="mt-4">
          <h3 class="text-lg font-bold">{j.company}, {j.role}</h3>
          <p class="text-base text-muted">{j.period}</p>
          <ul class="mt-2 space-y-1 text-lg">
            {j.missions.map((m) => <li>{m}</li>)}
          </ul>
        </div>
      ))}

      <h2 class="mt-10 text-2xl font-bold">Projets</h2>
      {projects.items.map((p) => (
        <div class="mt-4">
          <h3 class="text-lg font-bold">{p.name} <span class="font-normal text-muted">[{p.kind}]</span></h3>
          <p class="mt-1 text-lg">{p.summary}</p>
        </div>
      ))}

      <h2 class="mt-10 text-2xl font-bold">Contact</h2>
      <ul class="mt-2 space-y-1 text-lg">
        {contact.channels.map((c) => (
          <li><a class="underline" href={c.href}>{c.label} : {c.value}</a></li>
        ))}
      </ul>
    </section>
  </noscript>
`n
  <script>
    import { initCvWorld } from "../scripts/cv-world";
    import { initArcadeIntro, initArcadeControls } from "../scripts/cv-arcade";
    const disposeCvWorld = initCvWorld();
    initArcadeControls();
    initArcadeIntro();
    window.addEventListener("pagehide", () => disposeCvWorld?.());
  </script>
</GameLayout>
