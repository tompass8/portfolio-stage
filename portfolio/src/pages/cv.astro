---
import GameLayout from "../layouts/GameLayout.astro";
import HudNavigation from "../components/game/HudNavigation.astro";
import InteractiveWorld from "../components/game/InteractiveWorld.astro";
import { resumeData } from "../data/resumeData";

const { spawn, skills, experience, projects, contact } = resumeData;
---
<GameLayout title="CV Interactif — Tom Passerman">
  <HudNavigation />
  <main class="relative">
    <h1 class="sr-only">CV interactif de Tom Passerman — développeur web, IA et gouvernance numérique</h1>
    <InteractiveWorld />
  </main>

  <noscript>
    <section class="mx-auto max-w-4xl px-6 py-16">
      <p class="font-sans text-3xl font-bold text-white">CV — Tom Passerman</p>
      <p class="mt-3 text-sm text-slate-300">{spawn.bio}</p>
      <ul class="mt-4 space-y-1 font-mono text-xs text-slate-300">
        {spawn.highlights.map((h) => <li>▸ {h}</li>)}
      </ul>

      <h2 class="mt-10 font-sans text-xl font-bold text-white">Compétences</h2>
      {skills.groups.map((g) => (
        <div class="mt-4">
          <h3 class="font-mono text-sm text-neon-blue">{g.title} — {g.level}</h3>
          <p class="mt-1 text-sm text-slate-300">{g.items.map((i) => i.name).join(" · ")}</p>
        </div>
      ))}

      <h2 class="mt-10 font-sans text-xl font-bold text-white">Expériences</h2>
      {experience.jobs.map((j) => (
        <div class="mt-4">
          <h3 class="font-sans font-bold text-white">{j.company} — {j.role}</h3>
          <p class="font-mono text-xs text-neon-blue">{j.period}</p>
          <ul class="mt-2 space-y-1 text-sm text-slate-300">
            {j.missions.map((m) => <li>› {m}</li>)}
          </ul>
        </div>
      ))}

      <h2 class="mt-10 font-sans text-xl font-bold text-white">Projets</h2>
      {projects.items.map((p) => (
        <div class="mt-4">
          <h3 class="font-sans font-bold text-white">{p.name} <span class="font-mono text-xs text-neon-blue">[{p.kind}]</span></h3>
          <p class="mt-1 text-sm text-slate-300">{p.summary}</p>
        </div>
      ))}

      <h2 class="mt-10 font-sans text-xl font-bold text-white">Contact</h2>
      <ul class="mt-2 space-y-1 font-mono text-sm">
        {contact.channels.map((c) => (
          <li><a class="text-neon-blue" href={c.href}>{c.label} — {c.value}</a></li>
        ))}
      </ul>
    </section>
  </noscript>

  <section class="relative border-t border-white/10 bg-bg px-6 py-16">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-neon-blue">Version classique</p>
      <h2 class="mt-3 font-sans text-2xl font-bold text-white">Tu préfères le CV en lecture directe ?</h2>
      <p class="mt-3 text-sm text-slate-400">
        Le parcours complet reste aussi disponible en version site classique, lisible sans animation.
        Tu peux aussi télécharger le PDF.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="rounded-md border border-neon-blue/50 bg-neon-blue/10 px-5 py-2.5 font-mono text-xs font-semibold text-white transition-colors hover:bg-neon-blue/25">
          Version site classique
        </a>
        <a href="/cv-tom-passerman.pdf.pdf" download class="rounded-md border border-neon-violet/50 bg-neon-violet/10 px-5 py-2.5 font-mono text-xs font-semibold text-white transition-colors hover:bg-neon-violet/25">
          Télécharger le CV (PDF)
        </a>
      </div>
    </div>
  </section>

  <script>
    import { initCvWorld } from "../scripts/cv-world";
    import { initCvContact } from "../scripts/cv-contact";
    import { initCvHelicopter } from "../scripts/cv-helicopter";
    const disposeCvWorld = initCvWorld();
    initCvContact();
    initCvHelicopter();
    window.addEventListener("pagehide", () => disposeCvWorld?.());
  </script>
</GameLayout>
