---
import SectionShell from "../timeline/SectionShell.astro";
import Particles from "./Particles";

type Accent = "blue" | "violet";

interface HeroCard {
  index: string;
  title: string;
  accent: Accent;
  body: string;
}

const heroCards: HeroCard[] = [
  {
    index: "01",
    title: "MON PARCOURS TERRAIN",
    accent: "blue",
    body: "Étudiant en informatique à <strong>Ynov Toulouse</strong>, j'ai déjà fait tourner des systèmes réels : chez <strong>Orange</strong>, l'automatisation des déploiements logiciels ; chez <strong>ITL</strong>, des infrastructures réseau critiques et de la vidéosurveillance IP. En parallèle, je conçois des <strong>applications web &amp; mobiles</strong>, du prototype au déploiement.",
  },
  {
    index: "02",
    title: "POURQUOI ALPHA TO OMEGA ?",
    accent: "blue",
    body: "Au-delà de composants isolés, je vise le cycle complet : <strong>recueil du besoin</strong>, architecture Astro, CI/CD, DNS/Cloudflare, diagnostic de logs — et la <strong>gouvernance IT</strong> des organisations que vous accompagnez.",
  },
  {
    index: "03",
    title: "L'IA COMME OUTIL CRITIQUE",
    accent: "violet",
    body: "Ce site a été co-construit avec l'IA, jamais livré sans relecture : architecture cadrée à la main, code <strong>vérifié ligne par ligne</strong>, erreurs Git/Vite/Tailwind corrigées manuellement, <strong>performance et accessibilité</strong> traitées comme des exigences.",
  },
];

const accentClass: Record<Accent, string> = {
  blue: "text-neon-blue",
  violet: "text-neon-violet",
};

const accentBorder: Record<Accent, string> = {
  blue: "border-white/10 hover:border-neon-blue/50",
  violet: "border-neon-violet/30 hover:border-neon-violet/70",
};

const accentGlow: Record<Accent, string> = {
  blue: "card-glow--blue",
  violet: "card-glow--violet",
};

const accentLine: Record<Accent, string> = {
  blue: "via-neon-blue",
  violet: "via-neon-violet",
};
---

<SectionShell id="hero" hash="a1b2c3d" message="init(A2Ω): candidature stage web, IA & gouvernance numérique" zone="dev" class="min-h-screen flex items-center">
  <div slot="background" aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <img
      src="/images/hero-bg.webp"
      alt=""
      width="1600"
      height="1067"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="kenburns absolute inset-0 h-full w-full object-cover opacity-[0.16] mix-blend-luminosity"
    />
    <div class="absolute inset-0 bg-linear-to-b from-bg/50 via-bg/20 to-bg"></div>
    <div
      class="aurora-a absolute -top-28 left-1/4 size-104 rounded-full opacity-20 blur-[130px]"
      style="background: var(--color-neon-blue);"
    ></div>
    <div
      class="aurora-b absolute top-1/3 right-8 size-88 rounded-full opacity-15 blur-[130px]"
      style="background: var(--color-neon-violet);"
    ></div>
    <Particles client:load />
  </div>

  <div class="relative z-10 py-14 md:py-20">
    <!-- Badge Candidature A2Ω -->
    <div
      data-hero-reveal
      class="inline-flex max-w-full flex-wrap items-center gap-2.5 rounded-full border border-neon-blue/30 bg-surface/90 px-4 py-1.5 font-mono text-xs text-slate-200 backdrop-blur-md"
    >
      <span class="relative flex size-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ok opacity-75"></span>
        <span class="relative inline-flex size-2 rounded-full bg-ok"></span>
      </span>
      <span class="font-semibold text-neon-blue">CANDIDATURE ALPHA TO OMEGA (A2Ω)</span>
      <span class="text-slate-600">|</span>
      <span>Toulouse · Stage 2 à 6 mois · Dispo immédiate</span>
    </div>

    <!-- Titre avec machine à écrire -->
    <h1 class="mt-6 max-w-4xl font-sans text-3xl font-extrabold tracking-tight text-white min-[360px]:text-4xl sm:text-6xl lg:leading-[1.08]">
      <span class="block text-base text-slate-400 font-mono font-normal mb-2 sm:text-xl">
        &gt; Tom Passerman — Étudiant Bachelor Informatique (Ynov Toulouse)
      </span>
      <span
        data-typewriter="Développement Web, IA & Gouvernance Numérique"
        class="bg-linear-to-r from-white via-slate-100 to-neon-blue bg-clip-text text-transparent"
      >
        Développement Web, IA &amp; Gouvernance Numérique
      </span>
      <span
        data-typewriter-cursor
        aria-hidden="true"
        class="ml-1 inline-block h-[0.85em] w-0.75 translate-y-1 animate-pulse bg-neon-blue shadow-[0_0_12px_var(--color-neon-blue)]"
      ></span>
    </h1>

    <p
      data-hero-reveal
      class="mt-5 max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg"
    >
      Ce site interactif est ma candidature pour rejoindre <strong class="text-white">Alpha to Omega</strong>.
      Il illustre ma compréhension de vos deux piliers : <span class="font-mono text-neon-blue">75% d'ingénierie web sur mesure</span>
      (du cadrage besoin au déploiement Cloudflare avec Astro, Git et APIs) et
      <span class="font-mono text-neon-violet">25% de gouvernance numérique</span>
      (cartographie SI, gestion des accès IAM, conformité RGPD et processus d'exploitation).
    </p>

    <!-- Boutons d'action -->
    <div data-hero-reveal class="mt-8 flex flex-wrap items-center gap-3.5">
      <a
        href="#dev"
        class="group relative inline-flex items-center gap-2.5 rounded-lg bg-neon-blue px-5 py-3 font-mono text-xs sm:text-sm font-semibold text-bg transition-all glow-blue-hover"
      >
        <span>01. Fil Conducteur Web (75%)</span>
        <span class="transition-transform group-hover:translate-x-1">-&gt;</span>
      </a>

      <a
        href="#governance"
        class="inline-flex items-center gap-2.5 rounded-lg border border-neon-violet/40 bg-surface/80 px-5 py-3 font-mono text-xs sm:text-sm text-slate-200 backdrop-blur-sm transition-colors hover:border-neon-violet hover:bg-neon-violet/10"
      >
        <span class="size-2 rounded-full bg-neon-violet shadow-[0_0_8px_var(--color-neon-violet)]"></span>
        <span>02. Gouvernance &amp; Mini-Jeu (25%)</span>
      </a>

      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-4 py-3 font-mono text-xs sm:text-sm text-slate-300 hover:border-white/40 hover:text-white"
      >
        <span>03. Mon Parcours &amp; Contact</span>
      </a>
    </div>

    <!-- 3 Cartes : parcours terrain / pourquoi A2Ω / l'IA comme outil critique -->
    <div
      data-hero-reveal
      class="mt-12 grid gap-4 border-t border-white/10 pt-8 md:grid-cols-3"
    >
      {
        heroCards.map((card) => (
          <article
            class={`group relative overflow-hidden rounded-xl border bg-surface/70 p-4 backdrop-blur-sm transition-[color,border-color,translate] duration-300 ${accentBorder[card.accent]} motion-safe:hover:-translate-y-1`}
          >
            <span
              aria-hidden="true"
              class={`pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100 ${accentGlow[card.accent]}`}
            />
            <span
              aria-hidden="true"
              class={`pointer-events-none absolute inset-x-4 top-0 h-px scale-x-0 bg-gradient-to-r from-transparent ${accentLine[card.accent]} to-transparent transition-transform duration-300 group-hover:scale-x-100`}
            />
            <h3
              class={`relative font-mono text-xs font-semibold transition-colors duration-300 group-hover:text-white ${accentClass[card.accent]}`}
            >
              {card.index} // {card.title}
            </h3>
            <p
              class="relative mt-2 text-xs leading-relaxed text-slate-300 transition-colors duration-300 group-hover:text-slate-200"
              set:html={card.body}
            />
          </article>
        ))
      }
    </div>
  </div>
</SectionShell>