---
// Porte du premier écran : numéro monumental, destination, flèche calée sur le bord
import Picto, { type PictoName } from "./Picto.astro";

interface Props {
  href: string;
  num: string;
  title: string;
  line: string;
  arrow?: PictoName;
}
const { href, num, title, line, arrow = "down" } = Astro.props;

// La flèche glisse dans la direction qu'elle annonce
const nudge: Partial<Record<PictoName, string>> = {
  down: "group-hover:translate-y-1",
  right: "group-hover:translate-x-1",
  "up-right": "group-hover:translate-x-0.5 group-hover:-translate-y-0.5",
};
---
<a
  href={href}
  class="press-lg group relative flex h-full min-h-[12rem] flex-col justify-between rounded-[6px] bg-sign p-6 text-ink no-underline hover:bg-sign-press sm:p-7 md:min-h-[19rem]"
>
  <span class="text-gate font-bold tracking-[-0.03em] tabular-nums">{num}</span>
  <span class="mt-4 flex items-end justify-between gap-4 md:mt-8">
    <span>
      <span class="block text-3xl font-bold leading-tight tracking-[-0.015em] sm:text-4xl">{title}</span>
      <span class="mt-1 block text-lg leading-snug text-ink-soft">{line}</span>
    </span>
    <Picto name={arrow} class:list={["transition-transform duration-200 ease-out", nudge[arrow]]} />
  </span>
</a>
