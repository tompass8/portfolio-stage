---
// Plan illustré de chaque projet, dessiné à partir des données réelles (src/data/projects.ts).
// Ce n'est pas une capture d'écran : la légende le dit explicitement.
interface Props {
  slug: string;
  title: string;
}
const { slug, title } = Astro.props;

const captions: Record<string, string> = {
  spark: "Un capteur par place détecte la voiture par variation du champ magnétique et prévient l'ESP32 maître, qui alimente le tableau de bord.",
  "le-gourmand": "Trois conteneurs sur un réseau Docker isolé, exécutés sans droits root ; la base garde ses données sur un volume.",
  ymmo: "Nginx sert l'interface Vue 3 et répartit vers deux services : l'API .NET 10 et l'agrégateur FastAPI qui analyse les biens.",
};
const spots = [true, true, false, true, false, true];
---
{captions[slug] && (
  <figure class="mt-8 rounded-[6px] bg-panel p-4 sm:p-5">
    <svg viewBox="0 0 480 300" class="w-full" role="img" aria-label={`Illustration du fonctionnement de ${title}`}>
      {slug === "spark" && (
        <>
          {spots.map((busy, i) => (
            <g>
              <rect x={24 + i * 72} y="16" width="72" height="104" class:list={[busy ? "fill-panel" : "fill-sign"]} />
              {busy && <rect x={38 + i * 72} y="30" width="44" height="70" rx="8" class="fill-ink" />}
              {!busy && <text x={60 + i * 72} y="72" text-anchor="middle" class="fill-ink font-sans" font-size="13" font-weight="700">LIBRE</text>}
              <rect x={53 + i * 72} y="110" width="14" height="14" class="fill-sign stroke-ink" stroke-width="3" />
              <path d={`M ${60 + i * 72} 124 L 240 204`} class="stroke-ink" stroke-width="2" stroke-dasharray="5 5" fill="none" />
            </g>
          ))}
          <path d="M 24 16 V 120 M 456 16 V 120" class="stroke-ink" stroke-width="4" />
          {[1, 2, 3, 4, 5].map((i) => <path d={`M ${24 + i * 72} 16 V 120`} class="stroke-ink" stroke-width="4" />)}
          <rect x="174" y="204" width="132" height="44" rx="6" class="fill-ink" />
          <text x="240" y="232" text-anchor="middle" class="fill-sign font-sans" font-size="15" font-weight="700">ESP32 maître</text>
          <text x="118" y="182" class="fill-ink font-sans" font-size="13" font-weight="600">ESP-NOW</text>
          <path d="M 306 226 H 352" class="stroke-ink" stroke-width="4" />
          <path d="M 344 218 L 354 226 L 344 234" class="stroke-ink" stroke-width="4" fill="none" />
          <rect x="356" y="196" width="112" height="60" rx="6" class="fill-sign stroke-ink" stroke-width="3" />
          <text x="412" y="221" text-anchor="middle" class="fill-ink font-sans" font-size="14" font-weight="700">Interface web</text>
          <text x="412" y="241" text-anchor="middle" class="fill-ink font-sans" font-size="13">2 places libres</text>
          <rect x="24" y="272" width="12" height="12" class="fill-sign stroke-ink" stroke-width="3" />
          <text x="44" y="283" class="fill-ink font-sans" font-size="13">ESP8266 + magnétomètre (un par place)</text>
        </>
      )}
      {slug === "le-gourmand" && (
        <>
          <rect x="128" y="20" width="336" height="236" rx="8" class="stroke-ink" stroke-width="3" stroke-dasharray="8 6" fill="none" />
          <text x="144" y="44" class="fill-ink font-sans" font-size="14" font-weight="700">Réseau Docker isolé</text>
          <rect x="16" y="112" width="92" height="52" rx="6" class="fill-panel stroke-ink" stroke-width="3" />
          <text x="62" y="143" text-anchor="middle" class="fill-ink font-sans" font-size="14" font-weight="700">Navigateur</text>
          <path d="M 108 138 H 140" class="stroke-ink" stroke-width="4" />
          {[
            { x: 140, label: "Client", sub: "Tailwind CSS" },
            { x: 248, label: "API", sub: "Express 5" },
            { x: 356, label: "Base", sub: "MySQL 8" },
          ].map((c, i) => (
            <g>
              <rect x={c.x} y="100" width="100" height="76" rx="6" class:list={[i === 1 ? "fill-sign" : "fill-panel", "stroke-ink"]} stroke-width="3" />
              <text x={c.x + 50} y="134" text-anchor="middle" class="fill-ink font-sans" font-size="15" font-weight="700">{c.label}</text>
              <text x={c.x + 50} y="154" text-anchor="middle" class="fill-ink font-sans" font-size="13">{c.sub}</text>
              {i > 0 && <rect x={c.x} y="184" width="100" height="20" rx="4" class="fill-ink" />}
              {i > 0 && <text x={c.x + 50} y="198" text-anchor="middle" class="fill-sign font-sans" font-size="11" font-weight="700">non-root · Alpine</text>}
            </g>
          ))}
          <path d="M 240 138 H 248 M 348 138 H 356" class="stroke-ink" stroke-width="4" />
          <rect x="356" y="216" width="100" height="28" rx="14" class="fill-panel stroke-ink" stroke-width="3" />
          <text x="406" y="234" text-anchor="middle" class="fill-ink font-sans" font-size="11" font-weight="700">Volume persistant</text>
          <path d="M 406 204 V 216" class="stroke-ink" stroke-width="3" />
          <text x="296" y="282" text-anchor="middle" class="fill-ink font-sans" font-size="13">Orchestré par Docker Compose</text>
        </>
      )}
      {slug === "ymmo" && (
        <>
          <rect x="16" y="16" width="448" height="44" rx="6" class="fill-ink" />
          <text x="240" y="44" text-anchor="middle" class="fill-sign font-sans" font-size="15" font-weight="700">Nginx · point d'entrée unique</text>
          {[
            { x: 16, label: "Interface", sub: "Vue 3 + Pinia", sub2: "catalogue, Chart.js" },
            { x: 168, label: "API", sub: ".NET 10", sub2: "auth JWT, biens, offres" },
            { x: 320, label: "Agrégateur", sub: "FastAPI", sub2: "scikit-learn" },
          ].map((s, i) => (
            <g>
              <path d={`M ${s.x + 72} 60 V 92`} class="stroke-ink" stroke-width="4" />
              <rect x={s.x} y="92" width="144" height="84" rx="6" class:list={[i === 0 ? "fill-sign" : "fill-panel", "stroke-ink"]} stroke-width="3" />
              <text x={s.x + 72} y="124" text-anchor="middle" class="fill-ink font-sans" font-size="15" font-weight="700">{s.label}</text>
              <text x={s.x + 72} y="144" text-anchor="middle" class="fill-ink font-sans" font-size="13" font-weight="600">{s.sub}</text>
              <text x={s.x + 72} y="162" text-anchor="middle" class="fill-ink font-sans" font-size="12">{s.sub2}</text>
            </g>
          ))}
          <path d="M 240 176 V 208 M 392 176 V 208" class="stroke-ink" stroke-width="4" />
          <rect x="168" y="208" width="144" height="40" rx="20" class="fill-panel stroke-ink" stroke-width="3" />
          <text x="240" y="233" text-anchor="middle" class="fill-ink font-sans" font-size="14" font-weight="700">PostgreSQL 16</text>
          <rect x="320" y="208" width="144" height="40" rx="20" class="fill-ink" />
          <text x="392" y="233" text-anchor="middle" class="fill-sign font-sans" font-size="14" font-weight="700">2M de biens</text>
          <text x="240" y="282" text-anchor="middle" class="fill-ink font-sans" font-size="13">Trois services orchestrés par Docker Compose</text>
        </>
      )}
    </svg>
    <figcaption class="mt-3 border-t-2 border-concrete pt-3 text-base text-muted">
      <strong class="text-ink">Illustration</strong>, pas une capture d'écran. {captions[slug]}
    </figcaption>
  </figure>
)}
