---
// Bandeau d'orientation collant : chaque entrée annonce une destination et sa flèche.
// Sous 1024 px, il devient une barre d'onglets (pictogramme au-dessus d'un libellé court)
// pour que toutes les destinations restent visibles.
import Picto, { type PictoName } from "./Picto.astro";

export interface SignItem {
  href: string;
  label: string;
  /** Libellé affiché sous 1024 px quand le libellé complet ne tient pas */
  short?: string;
  picto: PictoName;
}
interface Props {
  items: SignItem[];
  home?: string;
}
const { items, home = "/" } = Astro.props;
---
<header class="sticky top-0 z-50 border-b-[6px] border-ink bg-sign" style="padding-top: env(safe-area-inset-top, 0px);">
  <div class="mx-auto flex max-w-[90rem] items-stretch gap-1 px-2 sm:px-6">
    <a href={home} class="flex shrink-0 items-center gap-3 py-2 pr-1 font-bold no-underline sm:py-3 sm:pr-8" aria-label="Tom Passerman, accueil">
      <span aria-hidden="true" class="grid size-10 place-items-center rounded-[6px] bg-ink text-lg font-bold tracking-tight text-sign sm:size-11">TP</span>
      <span aria-hidden="true" class="hidden text-xl leading-none tracking-tight lg:inline">Tom Passerman</span>
    </a>
    <nav aria-label="Orientation" class="flex min-w-0 flex-1 items-stretch justify-between gap-0.5 sm:justify-start sm:gap-2 lg:flex-none lg:gap-1">
      {items.map((item) => (
        <a
          href={item.href}
          data-sign-link={item.href.startsWith("#") ? item.href.slice(1) : undefined}
          class="press flex min-w-0 flex-1 flex-col items-center justify-center gap-1 rounded-[6px] px-1 py-1.5 text-[0.8125rem] font-semibold leading-none no-underline hover:bg-sign-press sm:flex-none sm:px-3 sm:text-[0.9375rem] lg:flex-row lg:gap-3 lg:py-2 lg:text-xl"
        >
          <Picto name={item.picto} size="sm" class="max-lg:size-8" />
          {item.short ? (
            <>
              <span class="truncate lg:hidden">{item.short}</span>
              <span class="hidden lg:inline">{item.label}</span>
            </>
          ) : (
            <span class="truncate">{item.label}</span>
          )}
        </a>
      ))}
    </nav>
  </div>
</header>
