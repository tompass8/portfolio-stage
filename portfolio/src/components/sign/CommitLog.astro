---
// Historique réel du dépôt (généré au démarrage par l'intégration git-log d'astro.config.mjs)
import commits from "../../data/commits.json";

interface Props {
  repoUrl: string;
}
const { repoUrl } = Astro.props;
---
{commits.length > 0 && (
  <figure class="on-dark rounded-[6px] bg-board p-5 sm:p-6">
    <figcaption class="flex flex-wrap items-baseline justify-between gap-2 text-on-board">
      <span class="text-lg font-semibold">Les derniers commits de ce site</span>
      <a href={repoUrl} target="_blank" rel="noreferrer" class="text-base text-board-muted underline hover:text-sign">Voir le dépôt sur GitHub</a>
    </figcaption>
    <ol class="mt-4 space-y-2 font-mono text-sm sm:text-base">
      {commits.map((c, i) => (
        <li data-rise style={`--d:${i}`} class="grid gap-x-4 rounded-[4px] bg-flap px-3 py-2 sm:grid-cols-[5.5rem_7rem_1fr]">
          <span class="text-flap-text">{c.hash}</span>
          <span class="text-board-muted">{c.date}</span>
          <span class="text-on-board [overflow-wrap:anywhere]">{c.subject}</span>
        </li>
      ))}
    </ol>
  </figure>
)}
