---
const items = [
  { label: "1. Zéro requête tierce (Polices locales)", status: "ACTIF" },
  { label: "2. Processus Arrivée / Départ (Onboarding/Offboarding)", status: "FORMALISÉ" },
  { label: "3. Vérification Backups & Dépendances de reprise", status: "CONTRÔLÉ" },
  { label: "4. Diagnostic d'incidents & Analyse de logs", status: "DOCUMENTÉ" },
];
---
<div data-gdpr-card data-rise class="lift flex h-full flex-col rounded-[6px] bg-panel p-5 sm:p-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-3xl font-bold leading-tight tracking-[-0.015em]">Protection des données dès la conception &amp; procédures IT</h3>
      <p class="mt-2 text-lg text-muted">
        Conformité RGPD &amp; continuité. Structurer l'existant, poser les bonnes questions aux équipes métiers et transformer un état des lieux en actions priorisées.
      </p>
    </div>
    <span class="grid size-16 shrink-0 place-items-center rounded-[6px] bg-ink text-sign">
      <svg viewBox="0 0 64 64" class="size-10" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="square" role="img" aria-label="Cadenas RGPD verrouillé">
        <path data-lock-shackle d="M20 28V18a12 12 0 0 1 24 0v10" />
        <rect x="14" y="28" width="36" height="26" fill="currentColor" stroke="none" />
        <rect x="29" y="36" width="6" height="10" class="fill-ink" stroke="none" />
      </svg>
    </span>
  </div>

  <ul class="mt-6 divide-y-2 divide-concrete border-y-2 border-concrete text-lg">
    {items.map((it) => (
      <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
        <span class="min-w-0">{it.label}</span>
        <span class="shrink-0 rounded-[4px] bg-ink px-2 py-0.5 font-mono text-sm tracking-[0.06em] text-sign">{it.status}</span>
      </li>
    ))}
  </ul>
</div>
