---
import { networkNodes } from "../../data/network";
---
<div class="rounded-[6px] bg-panel p-5 sm:p-8">
  <h3 class="text-3xl font-bold leading-tight tracking-[-0.015em]">
    Architecture cible : inventaire, dépendances &amp; points de contrôle
  </h3>
  <p class="mt-2 max-w-[46rem] text-lg text-muted">
    Schéma proposé pour l'organisation cible (A2Ω) — chaque brique, son propriétaire, ses données et ses garde-fous.
    Sélectionnez un nœud pour l'inspecter.
  </p>

  <div class="mt-8 grid gap-8 lg:grid-cols-5 lg:items-center">
    <div class="lg:col-span-3">
      <svg viewBox="0 0 580 260" class="w-full select-none" aria-labelledby="netmap-title">
        <title id="netmap-title">Cartographie réseau entre Cloudflare Edge, Astro, API IAM et Base de données</title>
        <g stroke="#0b0b0b" stroke-width="3" fill="none">
          <path d="M 90 130 L 290 70" />
          <path d="M 90 130 L 290 190" />
          <path d="M 290 70 L 290 190" stroke-dasharray="8 6" />
          <path d="M 290 70 L 490 130" />
          <path d="M 290 190 L 490 130" />
        </g>
        {networkNodes.map((node, index) => (
          <g
            data-net-node={node.id}
            tabindex="0"
            role="button"
            aria-pressed={index === 0 ? "true" : "false"}
            aria-controls="netmap-panel"
            aria-label={`Inspecter ${node.label}`}
            class="cursor-pointer"
          >
            <circle data-node-ring cx={node.x} cy={node.y} r="30" fill={index === 0 ? "#ffcc00" : "#ffffff"} stroke="#0b0b0b" stroke-width="5" />
            <circle cx={node.x} cy={node.y} r="7" fill="#0b0b0b" />
            <text x={node.x} y={node.y < 130 ? node.y - 42 : node.y + 54} text-anchor="middle" fill="#0b0b0b" font-size="15" font-weight="600" font-family="Source Sans 3 Variable, sans-serif">
              {node.label}
            </text>
          </g>
        ))}
      </svg>
    </div>

    <div id="netmap-panel" aria-live="polite" class="rounded-[6px] bg-concrete p-5 lg:col-span-2">
      <p class="text-2xl font-bold leading-tight" data-node-title>{networkNodes[0].label}</p>
      <dl class="mt-4 space-y-3 text-lg">
        <div><dt class="text-base text-muted">Rôle dans l'architecture</dt><dd data-node-role class="font-semibold">{networkNodes[0].role}</dd></div>
        <div><dt class="text-base text-muted">Responsable / Propriétaire</dt><dd data-node-owner class="font-semibold">{networkNodes[0].owner}</dd></div>
        <div><dt class="text-base text-muted">Données traitées</dt><dd data-node-data>{networkNodes[0].dataTypes}</dd></div>
        <div><dt class="text-base text-muted">Continuité / Sauvegarde</dt><dd data-node-backup>{networkNodes[0].backupPolicy}</dd></div>
        <div><dt class="text-base text-muted">Conformité RGPD</dt><dd data-node-gdpr>{networkNodes[0].gdprStatus}</dd></div>
      </dl>
    </div>
  </div>
</div>
