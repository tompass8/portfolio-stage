---
import { networkNodes } from "../../data/network";
---
<div class="rounded-2xl border border-neon-violet/25 bg-surface/85 p-5 sm:p-6 backdrop-blur-md">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 pb-4">
    <div>
      <span class="font-mono text-xs text-neon-violet">CARTOGRAPHIE SI &amp; FLUX DE DONNÉES</span>
      <h3 class="font-sans text-lg font-bold text-white">
        Architecture cible : inventaire, dépendances &amp; points de contrôle
      </h3>
      <p class="mt-1 font-mono text-[11px] text-slate-400">
        Schéma proposé pour l'organisation cible (A2Ω) — chaque brique, son propriétaire, ses données et ses garde-fous.
      </p>
    </div>
    <span class="rounded-full border border-neon-violet/40 bg-neon-violet/10 px-3 py-1 font-mono text-[11px] text-neon-violet">
      Cliquez sur un nœud pour inspecter
    </span>
  </div>

  <div class="mt-5 grid gap-6 lg:grid-cols-5 lg:items-center">
    <!-- Schéma SVG animé -->
    <div class="lg:col-span-3 overflow-x-auto">
      <svg
        viewBox="0 0 580 260"
        class="w-full min-w-[420px] select-none"
        role="img"
        aria-label="Cartographie réseau interactive entre Cloudflare Edge, Astro, API IAM et Base de données"
      >
        <defs>
          <linearGradient id="govLink" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#00e5ff" />
            <stop offset="100%" stop-color="#a855f7" />
          </linearGradient>
        </defs>

        <!-- Liens de flux -->
        <g stroke="url(#govLink)" stroke-width="2" fill="none" opacity="0.65">
          <path data-net-link d="M 90 130 L 290 70" stroke-dasharray="6 6" />
          <path data-net-link d="M 90 130 L 290 190" stroke-dasharray="6 6" />
          <path data-net-link d="M 290 70 L 290 190" stroke-dasharray="6 6" />
          <path data-net-link d="M 290 70 L 490 130" stroke-dasharray="6 6" />
          <path data-net-link d="M 290 190 L 490 130" stroke-dasharray="6 6" />
        </g>

        <!-- Nœuds cliquables -->
        {networkNodes.map((node, index) => (
          <g
            data-net-node={node.id}
            tabindex="0"
            role="button"
            aria-label={`Inspecter ${node.label}`}
            class="cursor-pointer transition-transform"
          >
            <circle
              cx={node.x}
              cy={node.y}
              r="28"
              fill="#0b0e1a"
              stroke={index === 0 ? "#00e5ff" : "#a855f7"}
              stroke-width="2"
            />
            <circle
              cx={node.x}
              cy={node.y}
              r="6"
              fill={index === 0 ? "#00e5ff" : "#a855f7"}
            />
            <text
              x={node.x}
              y={node.y + 44}
              text-anchor="middle"
              fill="#e5e7eb"
              font-size="11"
              font-family="JetBrains Mono Variable, monospace"
            >
              {node.label}
            </text>
          </g>
        ))}
      </svg>
    </div>

    <!-- Panneau d'inspection du nœud sélectionné -->
    <div class="lg:col-span-2 rounded-xl border border-white/10 bg-black/40 p-4 font-mono text-xs">
      <div class="flex items-center justify-between border-b border-white/10 pb-2">
        <span class="text-neon-violet font-semibold" data-node-title>
          {networkNodes[0].label}
        </span>
        <span class="rounded bg-ok/15 px-2 py-0.5 text-[10px] text-ok">AUDIT OK</span>
      </div>
      <dl class="mt-3 space-y-2.5 text-slate-300">
        <div>
          <dt class="text-[10px] uppercase text-slate-400">Rôle dans l'architecture</dt>
          <dd data-node-role class="mt-0.5 text-white">{networkNodes[0].role}</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase text-slate-400">Responsable / Propriétaire</dt>
          <dd data-node-owner class="mt-0.5 text-neon-blue">{networkNodes[0].owner}</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase text-slate-400">Données traitées</dt>
          <dd data-node-data class="mt-0.5">{networkNodes[0].dataTypes}</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase text-slate-400">Continuité / Sauvegarde</dt>
          <dd data-node-backup class="mt-0.5">{networkNodes[0].backupPolicy}</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase text-slate-400">Conformité RGPD</dt>
          <dd data-node-gdpr class="mt-0.5 text-ok">{networkNodes[0].gdprStatus}</dd>
        </div>
      </dl>
    </div>
  </div>
</div>