---
import SectionShell from "../timeline/SectionShell.astro";
import NetworkMap from "./NetworkMap.astro";
import GdprLock from "./GdprLock.astro";
import RolesMatrix from "./RolesMatrix";
import PacketFirewallGame from "../game/PacketFirewallGame";
---

<SectionShell
  id="governance"
  hash="c7d8e9f"
  message="feat(governance): SI cartography, IAM matrix & GDPR compliance (25%)"
  zone="gov"
  class="py-12 md:py-20"
>
  <div class="mt-6 max-w-3xl">
    <span class="font-mono text-xs uppercase tracking-widest text-neon-violet">
      03 // LE BOUCLIER — GOUVERNANCE NUMÉRIQUE &amp; ORGANISATION IT (25%)
    </span>
    <h2 data-reveal-title class="mt-2 font-sans text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Du flux de code à un environnement structuré, auditable et résilient
    </h2>
    <p class="mt-3 text-base text-slate-300">
      Les missions d'accompagnement que vous menez chez Alpha to Omega — recensement des actifs,
      cartographie des flux, contrôle des habilitations (IAM), conformité RGPD et formalisation des
      procédures d'exploitation — sont le terrain que je vise : voici comment je m'y intégrerais.
    </p>
  </div>

  <!-- Photo infrastructure SI -->
  <div class="relative mt-8 overflow-hidden rounded-2xl border border-white/10">
    <img
      src="/images/gov-servers.webp"
      alt=""
      width="1600"
      height="1067"
      loading="lazy"
      decoding="async"
      class="kenburns h-44 w-full object-cover object-center opacity-70 grayscale-[40%] md:h-60"
    />
    <div class="absolute inset-0 bg-linear-to-r from-neon-violet/25 via-transparent to-bg/85"></div>
    <p class="absolute bottom-3 left-4 right-4 font-mono text-[11px] leading-snug text-slate-300">
      <span class="text-neon-violet">▍</span> INFRASTRUCTURE SI — HÉBERGEMENT, RÉSEAU &amp; SAUVEGARDE
    </p>
  </div>

  <!-- Cartographie interactive SVG -->
  <div class="mt-8">
    <NetworkMap />
  </div>

  <!-- Grille Cadenas RGPD + Matrice des Rôles -->
  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <GdprLock />
    <div class="lg:col-span-2">
      <RolesMatrix client:visible />
    </div>
  </div>

  <!-- Mini-jeu interactif -->
  <PacketFirewallGame client:visible />
</SectionShell>