---
import { stats } from "../../data/stats";

const cols =
  stats.length >= 4 ? "md:grid-cols-4" : stats.length === 3 ? "md:grid-cols-3" : "md:grid-cols-2";
---
<div class="relative mt-16 border-t border-white/10 pt-10">
  <!-- Balayage lumineux animé en fond -->
  <div class="stats-sweep pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="flex items-end justify-between gap-4">
    <span class="font-mono text-xs uppercase tracking-widest text-neon-blue">
      En chiffres
    </span>
    <span class="h-px flex-1 bg-linear-to-r from-neon-blue/40 via-white/10 to-transparent"></span>
  </div>

  <div class="relative">
    <!-- Ligne de scan qui traverse les chiffres toutes les 5 s -->
    <div class="stats-line pointer-events-none absolute inset-y-0 left-0 -z-10 w-full" aria-hidden="true"></div>

    <dl class={`mt-6 grid grid-cols-2 gap-6 ${cols}`}>
      {stats.map((stat) => (
        <div class="flex flex-col">
          <dt class="order-2 mt-1 font-mono text-[11px] uppercase tracking-widest text-slate-400">
            {stat.label}
          </dt>
          <dd class="order-1 font-sans text-3xl font-bold tracking-tight text-white sm:text-4xl">
            <span data-counter data-end-val={stat.value}>
              {stat.value.toLocaleString("fr-FR", {
                minimumFractionDigits: Number.isInteger(stat.value) ? 0 : 1,
                maximumFractionDigits: 1,
              })}
            </span>{stat.suffix}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</div>
