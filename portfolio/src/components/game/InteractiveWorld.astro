---
import { resumeData } from "../../data/resumeData";
import Picto, { type PictoName } from "../sign/Picto.astro";

const { zones, spawn, skills, experience, projects, contact } = resumeData;
const worldWidth = zones.reduce((s, z) => s + z.width, 0);

const zonePicto: Record<string, PictoName> = {
  spawn: "pin",
  skills: "grid",
  experience: "briefcase",
  projects: "gate",
  contact: "mail",
};
---
<div id="cv-world" class="relative bg-board" data-world>
  <!-- Piste de scroll horizontale (largeur = largeur du monde) -->
  <div
    data-hscroll
    class="relative h-screen w-full overflow-x-auto overflow-y-hidden overscroll-x-contain"
    tabindex="0"
    role="region"
    aria-label="CV interactif — défilement horizontal"
  >
    <div data-hscroll-inner class="relative h-screen" style={`width:${worldWidth}px`}>
      <div data-viewport class="sticky left-0 top-0 h-screen overflow-hidden" style={`--world-w:${worldWidth}px`}>
        <!-- Fonds parallaxe -->
        <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
          <div class="world-layer layer-sky" data-layer="sky"></div>
          <div class="world-layer layer-far" data-layer="far"></div>
          <div class="world-layer layer-mid" data-layer="mid"></div>
        </div>

        <!-- Le monde (translation horizontale) -->
        <div
          data-world-container
          class="absolute inset-y-0 left-0 flex items-end pb-16"
          style={`width:${worldWidth}px`}
        >
          {zones.map((zone) => (
            <section
              id={zone.id}
              data-zone={zone.hash}
              data-zone-width={zone.width}
              class="relative h-full shrink-0 overflow-hidden"
              style={`width:${zone.width}px`}
              aria-labelledby={`${zone.id}-title`}
            >
              <div class="ground-strip" aria-hidden="true"></div>

              {zone.kind === "experience" && (
                <div data-decor class="absolute bottom-16 left-0 right-0 z-0 flex items-end justify-around px-8" aria-hidden="true">
                  <img src="/assets/props/security-cam.png" alt="" width="170" height="230" class="pixelated" data-jump-prop />
                  <img src="/assets/props/server-rack.png" alt="" width="170" height="230" class="pixelated" data-jump-prop />
                  <img src="/assets/props/telecom-tower.png" alt="" width="190" height="250" class="pixelated" data-jump-prop />
                  <img src="/assets/props/control-screen.png" alt="" width="170" height="230" class="pixelated" data-jump-prop />
                </div>
              )}

              {zone.kind === "projects" && (
                <div data-decor class="absolute inset-0 z-0" aria-hidden="true">
                  <img src="/assets/props/floating-platform.png" alt="" width="130" height="173" class="pixelated absolute bottom-44 left-[6%]" data-jump-platform />
                  <img src="/assets/props/floating-platform.png" alt="" width="130" height="173" class="pixelated absolute bottom-60 left-[44%]" data-jump-platform />
                  <img src="/assets/props/floating-platform.png" alt="" width="130" height="173" class="pixelated absolute bottom-48 left-[80%]" data-jump-platform />
                  <img src="/assets/props/server-rack.png" alt="" width="120" height="160" class="pixelated absolute bottom-16 left-[26%]" data-jump-prop data-avatar-use-target />
                  <img src="/assets/props/server-rack.png" alt="" width="120" height="160" class="pixelated absolute bottom-16 left-[66%]" data-jump-prop />
                  <img src="/assets/props/telecom-tower.png" alt="" width="120" height="160" class="pixelated absolute bottom-16 right-[3%]" />
                </div>
              )}

              {zone.kind === "skills" && (
                <div data-decor class="absolute bottom-16 left-0 right-0 z-0 flex items-end justify-between px-16" aria-hidden="true">
                  <img src="/assets/props/server-rack.png" alt="" width="180" height="240" class="pixelated" data-avatar-use-target />
                  <img src="/assets/props/control-screen.png" alt="" width="190" height="255" class="pixelated" />
                  <img src="/assets/props/server-rack.png" alt="" width="180" height="240" class="pixelated" data-avatar-use-target />
                  <img src="/assets/npc/teammate-idle.png" alt="" width="190" height="190" class="pixelated" />
                </div>
              )}

              {zone.kind === "contact" && (
                <img
                  data-decor
                  src="/assets/props/arcade-terminal.png"
                  alt=""
                  width="180"
                  height="240"
                  class="pixelated absolute bottom-16 left-[14%] z-0"
                  data-avatar-use-target
                  aria-hidden="true"
                />
              )}

              <!-- Panneau suspendu de la zone -->
              <div class="zone-sign absolute left-10 right-10 top-[5.5rem] z-10 flex max-w-max items-center gap-4 rounded-[6px] bg-sign px-4 py-3 text-ink">
                <Picto name={zonePicto[zone.kind]} />
                <div>
                  <h2 id={`${zone.id}-title`} class="text-3xl font-bold leading-tight tracking-[-0.015em] sm:text-4xl">{zone.title}</h2>
                  <p class="zone-subtitle text-lg font-semibold">{zone.subtitle}</p>
                </div>
                <p class="zone-level ml-2 self-start rounded-[4px] bg-ink px-3 py-2 font-mono text-sm leading-snug text-sign max-md:hidden">{zone.level}</p>
              </div>

              <div data-checkpoint-dot class="pointer-events-none absolute bottom-24 left-1/2 z-10 size-3 -translate-x-1/2 rounded-full bg-panel/20"></div>

              <div class="zone-body relative z-10 flex h-full flex-col justify-end px-10 pb-24">
                {zone.kind === "spawn" && (
                  <div class="mt-4 grid max-w-4xl gap-4 md:grid-cols-2">
                    <div class="rounded-[6px] bg-panel p-5 text-ink">
                      <p class="text-lg leading-relaxed">{spawn.bio}</p>
                      <ul class="mt-4 space-y-1.5 text-base font-semibold">
                        {spawn.highlights.map((h) => (
                          <li class="flex gap-3"><span aria-hidden="true" class="mt-[0.55em] size-2 shrink-0 bg-ink"></span>{h}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="flex flex-col gap-3">
                      {spawn.controls.map((c) => (
                        <div class="flex items-center gap-3 rounded-[6px] bg-panel px-4 py-3 text-ink">
                          <span class="grid size-12 shrink-0 place-items-center rounded-[6px] bg-ink">
                            <img src={`/assets/ui/${c.icon}.png`} alt="" width="40" height="40" class="pixelated" />
                          </span>
                          <span class="text-lg font-semibold">{c.label}</span>
                        </div>
                      ))}
                      <p class="rounded-[6px] bg-sign px-4 py-3 text-lg font-semibold text-ink">J'adore les échecs et le football !</p>
                    </div>
                  </div>
                )}

                {zone.kind === "skills" && (
                  <div class="mt-4 grid max-w-6xl gap-3 sm:grid-cols-2 lg:grid-cols-4">
                    {skills.groups.map((g) => {
                      const segments = 10;
                      const lit = Math.round((g.pct / 100) * segments);
                      return (
                        <div data-reveal class="rounded-[6px] bg-panel p-4 text-ink">
                          <div class="flex items-baseline justify-between gap-2">
                            <h3 class="text-lg font-bold leading-tight">{g.title}</h3>
                            <span data-energy-value class="font-mono text-sm font-semibold" data-target={g.pct}>{g.pct}%</span>
                          </div>
                          <div data-energy-gauge class="mt-2 flex gap-0.5" aria-hidden="true">
                            {Array.from({ length: segments }).map((_, i) => (
                              <span data-seg data-lit={i < lit ? "1" : "0"} class={`h-2.5 flex-1 ${i < lit ? "bg-ink" : "bg-concrete"}`}></span>
                            ))}
                          </div>
                          <p class="mt-1.5 text-sm font-semibold text-muted">{g.level}</p>
                          <ul class="mt-2 space-y-0.5 text-base">
                            {g.items.map((it) => <li>{it.name}</li>)}
                          </ul>
                        </div>
                      );
                    })}
                  </div>
                )}

                {zone.kind === "experience" && (
                  <div class="mt-4 flex max-w-6xl flex-wrap items-end gap-4">
                    {experience.jobs.map((job) => (
                      <div data-reveal class="on-dark w-full max-w-sm rounded-[6px] bg-board p-5 ring-4 ring-sign">
                        <div class="flex items-baseline justify-between gap-3">
                          <h3 class="text-2xl font-bold text-sign">{job.company}</h3>
                          <span class="font-mono text-sm uppercase tracking-[0.06em] text-flap-text">{job.period}</span>
                        </div>
                        <p class="mt-1 text-lg font-semibold text-on-board">{job.role}</p>
                        <ul class="mt-3 space-y-1.5 text-base text-on-board">
                          {job.missions.map((m) => (
                            <li class="flex gap-3"><span aria-hidden="true" class="mt-[0.55em] size-2 shrink-0 bg-sign"></span>{m}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                    <div data-reveal class="w-full max-w-xs rounded-[6px] bg-panel p-5 text-ink">
                      <h3 class="text-lg font-bold">Répartition des tâches</h3>
                      <dl class="mt-3 space-y-3">
                        {experience.split.map((s) => (
                          <div>
                            <div class="flex justify-between text-base"><dt>{s.label}</dt><dd class="font-mono font-semibold">{s.value}%</dd></div>
                            <span aria-hidden="true" class="mt-1 block h-2.5 bg-concrete"><span class="block h-full bg-ink" style={`width:${s.value}%`}></span></span>
                          </div>
                        ))}
                      </dl>
                    </div>
                  </div>
                )}

                {zone.kind === "projects" && (
                  <div data-project-row class="mt-4 flex max-w-[1900px] gap-4 overflow-visible">
                    {projects.items.map((p) => (
                      <article data-project={p.id} data-checkpoint={p.checkpoint ? "1" : "0"} class="w-[340px] shrink-0 rounded-[6px] bg-panel p-5 text-ink">
                        <div class="flex items-center justify-between">
                          <span class="rounded-[4px] bg-ink px-2 py-0.5 text-sm font-semibold text-sign">{p.kind}</span>
                          <span data-checkpoint-light class="size-3 rounded-full bg-concrete"></span>
                        </div>
                        <h3 class="mt-3 text-xl font-bold leading-tight">{p.name}</h3>
                        <p class="mt-2 text-base leading-relaxed">{p.summary}</p>
                        <ul class="mt-3 space-y-1 text-base">
                          {p.features.map((f) => (
                            <li class="flex gap-2.5"><span aria-hidden="true" class="mt-[0.55em] size-1.5 shrink-0 bg-ink"></span>{f}</li>
                          ))}
                        </ul>
                        <p class="mt-3 text-sm font-semibold text-muted">{p.stack.join(" · ")}</p>
                      </article>
                    ))}
                  </div>
                )}

                {zone.kind === "contact" && (
                  <div class="mt-4 flex max-w-5xl flex-wrap items-stretch gap-4">
                    <a href="mailto:tompasserman5@gmail.com?subject=Proposition%20de%20stage%20%2F%20alternance" class="flex w-full max-w-md flex-col justify-between gap-6 rounded-[6px] bg-sign p-5 text-ink no-underline hover:bg-sign-press">
                      <span class="flex items-center gap-3"><Picto name="mail" /><span class="text-2xl font-bold">Écrire à Tom</span></span>
                      <span class="break-all text-xl font-semibold underline">tompasserman5@gmail.com</span>
                    </a>
                    <div class="flex flex-col gap-3">
                      {contact.channels.filter((c) => c.label !== "Email").map((c) => (
                        <a href={c.href} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-[6px] bg-panel px-4 py-3 text-lg font-semibold text-ink no-underline hover:bg-sign">
                          <Picto name={c.label === "GitHub" ? "github" : "linkedin"} size="sm" />
                          {c.label} — {c.value}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </section>
          ))}
        </div>

        <!-- Avatar fixe -->
        <div data-avatar class="pointer-events-none absolute bottom-16 z-30" style="left:20%" aria-hidden="true">
          <div data-avatar-shell class="sprite-shell is-right">
            <div data-avatar-sprite class="sprite sprite--idle"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
