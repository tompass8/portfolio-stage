---
---
<div class="arcade-heli" data-heli data-heli-variant="ground" aria-hidden="true">
 <div class="arcade-heli__flip">
  <div class="arcade-heli__boom" data-heli-boom>
    <span class="arcade-heli__blast"></span>
    <span class="arcade-heli__smoke arcade-heli__smoke--1"></span>
    <span class="arcade-heli__smoke arcade-heli__smoke--2"></span>
    <span class="arcade-heli__smoke arcade-heli__smoke--3"></span>
    <span class="arcade-heli__debris arcade-heli__debris--1" style="--dx:-26px;--dy:-18px;--dr:210deg"></span>
    <span class="arcade-heli__debris arcade-heli__debris--2" style="--dx:24px;--dy:-24px;--dr:-170deg"></span>
    <span class="arcade-heli__debris arcade-heli__debris--3" style="--dx:-20px;--dy:18px;--dr:320deg"></span>
    <span class="arcade-heli__debris arcade-heli__debris--4" style="--dx:22px;--dy:16px;--dr:95deg"></span>
  </div>

  <div class="arcade-heli__body" data-heli-body>
    <span class="arcade-heli__tail"></span>
    <span class="arcade-heli__fin"></span>
    <span class="arcade-heli__tail-rotor"></span>
    <span class="arcade-heli__cabin"></span>
    <span class="arcade-heli__cockpit"></span>
    <span class="arcade-heli__light arcade-heli__light--red"></span>
    <span class="arcade-heli__light arcade-heli__light--blue"></span>
    <span class="arcade-heli__skids"></span>
    <span class="arcade-heli__disc"></span>
    <span class="arcade-heli__rotor"></span>
  </div>

  <div class="arcade-heli__rocket" data-heli-rocket>
    <span class="arcade-heli__flame"></span>
  </div>
 </div>
</div>
