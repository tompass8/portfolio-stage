---
// HUD du CV : sous 1024 px, barre d'onglets (pictogramme au-dessus d'un libellé court)
// pour que les cinq zones restent visibles, comme le bandeau du site.
import { resumeData } from "../../data/resumeData";
import Picto, { type PictoName } from "../sign/Picto.astro";

const { zones } = resumeData;

const zonePicto: Record<string, PictoName> = {
  spawn: "pin",
  skills: "grid",
  experience: "briefcase",
  projects: "gate",
  contact: "mail",
};
const shortLabel: Record<string, string> = {
  competences: "Stack",
  experiences: "Parcours",
};
---
<header class="fixed inset-x-0 top-0 z-50 border-b-[6px] border-ink bg-sign text-ink" style="padding-top: env(safe-area-inset-top, 0px);" data-hud>
  <div class="mx-auto flex max-w-[90rem] items-center gap-1 px-2 py-1.5 sm:px-6 lg:gap-2 lg:py-2">
    <a href="/" class="press flex shrink-0 items-center gap-2.5 rounded-[6px] py-1 pr-1 text-lg font-semibold no-underline lg:pr-3">
      <Picto name="left" size="sm" />
      <span class="hidden lg:inline">Site classique</span>
      <span class="sr-only lg:hidden">Retour au site classique</span>
    </a>

    <nav class="flex min-w-0 flex-1 justify-between gap-0.5 sm:justify-start sm:gap-2 lg:gap-1" aria-label="Téléportation par niveau">
      {zones.map((z) => (
        <button
          type="button"
          data-teleport={z.hash}
          class="press inline-flex min-h-11 min-w-0 flex-1 cursor-pointer flex-col items-center justify-center gap-1 rounded-[6px] px-1 py-1 text-[0.8125rem] font-semibold leading-none hover:bg-sign-press sm:flex-none sm:px-3 lg:flex-row lg:px-3 lg:text-lg"
        >
          <Picto name={zonePicto[z.kind]} size="sm" class="size-8 lg:hidden" />
          {shortLabel[z.hash] ? (
            <>
              <span class="truncate lg:hidden">{shortLabel[z.hash]}</span>
              <span class="hidden lg:inline">{z.short}</span>
            </>
          ) : (
            <span class="truncate">{z.short}</span>
          )}
        </button>
      ))}
    </nav>

    <div data-progress-wrap class="hidden shrink-0 items-center gap-3 lg:flex">
      <span class="text-base font-semibold">Progression</span>
      <span class="relative block h-3 w-28 bg-ink/15" aria-hidden="true">
        <span data-progress-bar class="absolute inset-y-0 left-0 w-0 bg-ink"></span>
      </span>
      <span data-progress-label class="w-11 font-mono text-base font-semibold tabular-nums">0%</span>
    </div>
  </div>
  <div data-progress-wrap class="h-1 w-full bg-ink/15 lg:hidden" aria-hidden="true">
    <span data-progress-bar class="block h-full w-0 bg-ink"></span>
  </div>
</header>

<!-- Les deux boutons de la borne : clic = un pas, appui long = on marche -->
<div data-arcade-controls class="fixed bottom-4 left-1/2 z-40 flex -translate-x-1/2 items-end gap-5" style="margin-bottom: env(safe-area-inset-bottom, 0px);">
  <button type="button" data-cv-step="-1" class="arcade-btn group flex cursor-pointer flex-col items-center gap-1.5" aria-label="Reculer">
    <span class="grid size-16 place-items-center rounded-full border-4 border-ink bg-on-board text-ink">
      <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true"><path d="M20 12H5M11 5l-7 7 7 7" /></svg>
    </span>
    <span class="rounded-[4px] bg-ink/80 px-2 py-0.5 text-sm font-bold text-on-board">Reculer</span>
  </button>
  <button type="button" data-cv-step="1" class="arcade-btn group flex cursor-pointer flex-col items-center gap-1.5" aria-label="Avancer">
    <span class="grid size-16 place-items-center rounded-full border-4 border-ink bg-sign text-ink">
      <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7" /></svg>
    </span>
    <span class="rounded-[4px] bg-ink/80 px-2 py-0.5 text-sm font-bold text-sign">Avancer</span>
  </button>
</div>