---
import { resumeData } from "../../data/resumeData";
import Picto from "../sign/Picto.astro";

const { zones } = resumeData;
---
<header class="fixed inset-x-0 top-0 z-50 border-b-[6px] border-ink bg-sign text-ink" style="padding-top: env(safe-area-inset-top, 0px);" data-hud>
  <div class="mx-auto flex max-w-[90rem] items-center gap-2 px-4 py-2 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5 rounded-[6px] py-1 pr-3 text-lg font-semibold no-underline">
      <Picto name="left" size="sm" />
      <span class="hidden sm:inline">Site classique</span>
      <span class="sr-only sm:hidden">Retour au site classique</span>
    </a>

    <nav class="flex min-w-0 flex-1 gap-1 overflow-x-auto [scrollbar-width:none]" aria-label="Téléportation par niveau">
      {zones.map((z) => (
        <button
          type="button"
          data-teleport={z.hash}
          class="inline-flex min-h-11 shrink-0 cursor-pointer items-center rounded-[6px] px-3 text-lg font-semibold transition-colors duration-150 hover:bg-sign-press"
        >
          {z.short}
        </button>
      ))}
    </nav>

    <div class="hidden shrink-0 items-center gap-3 md:flex">
      <span class="text-base font-semibold">Progression</span>
      <span class="relative block h-3 w-28 bg-ink/15" aria-hidden="true">
        <span data-progress-bar class="absolute inset-y-0 left-0 w-0 bg-ink"></span>
      </span>
      <span data-progress-label class="w-11 font-mono text-base font-semibold tabular-nums">0%</span>
    </div>
  </div>
  <div class="h-1 w-full bg-ink/15 md:hidden" aria-hidden="true">
    <span data-progress-bar class="block h-full w-0 bg-ink"></span>
  </div>
</header>

<div
  data-scroll-hint
  aria-hidden="true"
  class="pointer-events-none fixed bottom-5 left-1/2 z-40 flex -translate-x-1/2 items-center gap-3 whitespace-nowrap rounded-[6px] bg-sign py-2 pl-2 pr-4 text-lg font-semibold text-ink transition-opacity duration-300"
>
  <Picto name="right" size="sm" />
  <span class="sm:hidden">Glissez pour avancer</span>
  <span class="hidden sm:inline">Glissez ou molette pour avancer</span>
</div>
