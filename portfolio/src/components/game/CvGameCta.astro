---
const { class: className = "" } = Astro.props;
---
<div class={`mx-auto max-w-5xl px-4 ${className}`}>
  <a
    href="/cv"
    class="group flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-amber-400/30 bg-surface/70 p-5 backdrop-blur-md transition-colors hover:border-amber-400/70"
  >
    <div class="flex items-center gap-4">
      <span
        aria-hidden="true"
        class="grid size-11 shrink-0 place-items-center rounded-xl border border-amber-400/40 bg-amber-400/10 font-mono text-lg text-amber-400"
      >
        ▶
      </span>
      <span>
        <span class="block font-mono text-[11px] uppercase tracking-widest text-amber-400">
          Bonus // CV interactif
        </span>
        <span class="mt-0.5 block font-sans text-base font-bold text-white sm:text-lg">
          Parcourir mon CV en jeu 2D side-scrolling
        </span>
      </span>
    </div>
    <span
      class="glow-amber-button rounded-lg border border-amber-400 bg-amber-400 px-4 py-2 font-mono text-xs font-semibold text-zinc-950 transition-colors hover:bg-amber-300"
    >
      Lancer le CV interactif →
    </span>
  </a>
</div>
