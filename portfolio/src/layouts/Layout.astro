---
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import GitTimeline from "../components/timeline/GitTimeline.astro";
import SectionNav from "../components/nav/SectionNav.astro";
import FixedCta from "../components/nav/FixedCta.astro";

interface Props { title: string; description?: string; }
const {
  title,
  description = "Candidature Tom Passerman — Alpha to Omega (Développement Web, IA & Gouvernance Numérique)",
} = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05060d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-bg font-sans antialiased selection:bg-neon-violet/40">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-20 overflow-hidden">
      <img
        src="/images/ambient-code.webp"
        alt=""
        width="1600"
        height="1067"
        loading="lazy"
        decoding="async"
        class="ambient-photo left-[-12%] top-[-18%] h-[70vh] w-[70vw] -rotate-6"
      />
      <img
        src="/images/hero-bg.webp"
        alt=""
        width="1600"
        height="1067"
        loading="lazy"
        decoding="async"
        class="ambient-photo ambient-photo--b bottom-[-22%] right-[-14%] h-[75vh] w-[65vw] rotate-3"
      />
      <div class="absolute inset-0 bg-linear-to-b from-bg/25 via-transparent to-bg/45"></div>
    </div>
    <div aria-hidden="true" class="bg-grid pointer-events-none fixed inset-0 -z-10"></div>
    <main id="timeline" class="relative overflow-x-clip">
      <GitTimeline />
      <slot />
    </main>
    <SectionNav />
    <FixedCta />
    <script>
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import { initSmoothScroll } from "../scripts/smooth-scroll";
      import { initTimeline } from "../scripts/timeline";
      import { initHero } from "../scripts/hero";
      import { initReveal } from "../scripts/reveal";
      import { initDevSection } from "../scripts/dev";
      import { initGovernanceSection } from "../scripts/governance";
      import { initProcess } from "../scripts/process";
      import { initCounters } from "../scripts/counters";
      import { initSectionNav } from "../scripts/section-nav";

      initSmoothScroll();
      initTimeline();
      initHero();
      initReveal();
      initDevSection();
      initGovernanceSection();
      initProcess();
      initCounters();
      initSectionNav();
      window.addEventListener("load", () => ScrollTrigger.refresh());
    </script>
  </body>
</html>