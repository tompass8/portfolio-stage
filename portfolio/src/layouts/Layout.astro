---
import "../styles/global.css";
import "@fontsource-variable/source-sans-3";
import "@fontsource-variable/jetbrains-mono";
import SignBand, { type SignItem } from "../components/sign/SignBand.astro";

interface Props {
  title: string;
  description?: string;
  nav: SignItem[];
  noindex?: boolean;
}
const {
  title,
  description = "Tom Passerman — étudiant en informatique à Ynov Toulouse : développement web & API, systèmes & réseaux, IoT. Projets, parcours et contact.",
  nav,
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffcc00" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class="bg-concrete font-sans text-[1.0625rem] leading-relaxed text-ink antialiased">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-ink focus:px-4 focus:py-3 focus:text-sign">
      Aller au contenu
    </a>
    <SignBand items={nav} />
    <main id="contenu">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      import { initWayfinding } from "../scripts/wayfinding";
      import { initBoards } from "../scripts/board";
      import { initGovernanceSection } from "../scripts/governance";
      import { initRolesMatrix } from "../scripts/roles";

      initWayfinding();
      initBoards();
      initGovernanceSection();
      initRolesMatrix();
    </script>
  </body>
</html>
